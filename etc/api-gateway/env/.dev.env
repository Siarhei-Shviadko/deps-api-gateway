ENV=local

# also used as csrf secret key
SECRET_KEY=test
CSRF_PROTECTION_ENABLED=false

SENTRY_ENABLED=false
SENTRY_DSN=

AUTH_VERIFY_SSL=false

CORLEONE_URL=http://deps-corleone-api:8000
PREPROCESS_URL=http://deps-preprocess-api:8000
DOCUMENT_URL=http://deps-document-api:8000

WORKFLOW_MANAGER_URL=http://deps-workflow-manager-api:8000
DOCUMENT_TYPE_URL=http://deps-document-type:8000
UNIFIER_URL=http://deps-unifier:8000
EXTRACTION_URL=http://deps-extraction:8000
IAM_URL=http://deps-iam-api:8000
OCR_URL=http://deps-ocr:8000
PROTOTYPE_URL=http://deps-prototype:8000
PARSING_URL=http://deps-parsing:8000
ENRICHMENT_URL=http://deps-enrichment:8000
PROMPTER_URL=http://deps-prompter:8000
HIGH_SPARROW_URL=http://deps-high-sparrow:8000
OUTPUT_EXPORTING_URL=http://deps-output-exporting:8000
VALIDATION_URL=http://deps-validation-api:8000
AI_FUSION_URL=http://deps-ai-fusion:8000
TEMPLATE_URL=http://deps-template:8000
GROUPS_URL=http://deps-groups:8000
CLASSIFICATION_URL=http://deps-classification:8000
CLOUD_NATIVE_EXTRACTION_URL=http://deps-cloud-native-extraction:8000
STORAGE_URL=http://deps-file-storage:8004
FILES_BATCH_URL=http://deps-files-batch:8000
EVENT_RELAY_URL=http://deps-event-relay:8000
AGENTIC_AI_URL=http://deps-agentic-ai:8000
FILE_URL=http://deps-file:8000
META_AGENT_URL=http://deps-meta-agent:8000
SEMANTIC_PARSING_URL=http://deps-semantic-parsing:8000
SPLITTING_URL=http://deps-splitting:8000
ANALYTIC_URL=http://deps-analytic:8000
LITELLM_URL=http://deps-litellm:4000
LITELLM_API_KEY=sk-1234

AUTHORIZATION_ENABLED=false

WORKFLOW_V2=true

# Telemetry
INSTRUMENTATION_ENABLED=false
SERVICE_NAME=deps-api-gateway
EXPORTER_TYPE=azure

# otlp example
OTLP_LOG_ENDPOINT=http://deps-otlp:4317
OTLP_TRACE_ENDPOINT=http://deps-otlp:4318/v1/traces
APPLICATION_INSIGHTS_CONNECTION_STRING=...

# Service Discovery
SERVICES='
[
    {"kubernetes_name": "nginx", "code": "nginx", "name": "Nginx", "mandatory": true},
    {"kubernetes_name": "api-gateway", "code": "api_gateway", "name": "API Gateway", "mandatory": true},
